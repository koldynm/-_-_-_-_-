<Window x:Class="мне_бы_жить_в_шоколаде.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowState="Maximized"
        Title="Панель управления — EduRepair" Height="600" Width="1000"
        Background="{DynamicResource MdSurface}">

    <Window.Resources>
        <Style x:Key="SidebarActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="12,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" MaxHeight="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="0" Grid.RowSpan="2" Background="{DynamicResource MdSurfaceContainer}" BorderThickness="0">
            <DockPanel Margin="0,24,0,16" LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="EduRepair"
                               Foreground="{DynamicResource MdPrimary}"
                               FontSize="24" FontWeight="Bold"
                               Margin="28,0,28,24" HorizontalAlignment="Left"/>

                    <Border Margin="16,0,16,8"
                            Background="{DynamicResource MdSurfaceContainerHigh}"
                            CornerRadius="14"
                            Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="NameText" Text="Загрузка..." TextWrapping="Wrap" Foreground="{DynamicResource MdOnSurface}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock x:Name="RoleText" Text="" Foreground="{DynamicResource MdOnSurfaceVariant}" FontSize="14" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource PrimaryButton}"
                                    Background="{DynamicResource MdTertiary}"
                                    Content="Выход"
                                    Click="ExitButton_Click"
                                    Margin="12,0,0,0"/>
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource NavSectionHeader}" Text="Заявки"/>

                    <RadioButton x:Name="OpenRequests"
                                 Content="Открытые заявки"
                                 GroupName="Nav"
                                 IsChecked="True"
                                 Style="{StaticResource MenuButton}"
                                 Click="OpenRequests_Click"/>

                    <RadioButton x:Name="AcceptedRequests"
                                 Content="Принятые заявки"
                                 GroupName="Nav"
                                 Style="{StaticResource MenuButton}"
                                 Click="AcceptedRequests_Click"/>

                    <RadioButton x:Name="ArchivedRequests"
                                 Content="Архив заявок"
                                 GroupName="Nav"
                                 Style="{StaticResource MenuButton}"
                                 Click="ArchivedRequests_Click"/>

                    <Button x:Name="BtnAddRequest"
                            Content="+ Новая заявка"
                            Style="{StaticResource SidebarActionButton}"
                            Click="BtnAddRequest_Click"/>

                    <StackPanel x:Name="AdminPanel" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource NavSectionHeader}" Text="Администрирование"/>
                        <RadioButton x:Name="UsersControl"
                                     Content="Пользователи"
                                     GroupName="Nav"
                                     Style="{StaticResource MenuButton}"
                                     Click="UsersControl_Click"/>
                        <RadioButton x:Name="EquipmentsControl"
                                     Content="Оборудование"
                                     GroupName="Nav"
                                     Style="{StaticResource MenuButton}"
                                     Click="EquipmentsControl_Click"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel x:Name="NavigationBar" Grid.Column="1" Orientation="Horizontal" Margin="20, 10, 0, 0">
            <Button x:Name="BackButton" Style="{StaticResource PrimaryButton}" Click="BackButton_Click" Content="Назад"/>
        </StackPanel>

        <Border Grid.Column="1" Grid.Row="1" Background="{DynamicResource MdSurface}" CornerRadius="24,0,0,0" Margin="0">
            <Frame x:Name="NavigationHost" NavigationUIVisibility="Hidden" />
        </Border>
    </Grid>
</Window>
