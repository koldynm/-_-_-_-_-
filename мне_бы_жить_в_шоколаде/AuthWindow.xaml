<Window x:Class="мне_бы_жить_в_шоколаде.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="550" Width="450"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MdSurface}" AllowsTransparency="False" WindowStyle="ThreeDBorderWindow">

    <Grid>
        <Grid.Background>
            <SolidColorBrush Color="LightCyan"/>
        </Grid.Background>

        <Border VerticalAlignment="Center" HorizontalAlignment="Center" 
                Width="360" Padding="40" Background="{DynamicResource MdSurfaceContainer}" CornerRadius="28">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Color="#000000" Opacity="0.3" ShadowDepth="4" Direction="270"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Вход в систему" FontSize="28" FontWeight="Medium" 
                           Foreground="{DynamicResource MdOnSurface}" HorizontalAlignment="Left" Margin="0,0,0,32"/>

                <TextBlock Text="Логин или Email" Foreground="{DynamicResource MdOnSurfaceVariant}" Margin="4,0,0,8" FontSize="14"/>
                <TextBox x:Name="emailTextBox" Style="{DynamicResource ModernInput}" Margin="0,0,0,24"/>

                <TextBlock Text="Пароль" Foreground="{DynamicResource MdOnSurfaceVariant}" Margin="4,0,0,8" FontSize="14"/>
                <PasswordBox x:Name="passwordPasswordBox" Style="{DynamicResource ModernInput}" Margin="0,0,0,32"/>

                <Button x:Name="SignInButton" Content="Войти" 
                        Style="{DynamicResource PrimaryButton}" 
                        Height="48"
                        Click="SignInButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>