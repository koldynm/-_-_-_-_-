<Page x:Class="мне_бы_жить_в_шоколаде.Pages.AddRequest"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Новая заявка">

    <Grid Background="{DynamicResource MdSurface}">
        <Border Padding="32" Background="{DynamicResource MdSurfaceContainer}" 
                Margin="40" CornerRadius="28" MaxWidth="500" VerticalAlignment="Top">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" Color="Black" Opacity="0.2" ShadowDepth="8" Direction="270"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Новая заявка" FontSize="28" FontWeight="Medium" 
                           Foreground="{DynamicResource MdOnSurface}" Margin="0,0,0,32" HorizontalAlignment="Center"/>

                <TextBlock Text="Оборудование" Foreground="{DynamicResource MdOnSurfaceVariant}" Margin="4,0,0,8"/>
                <ComboBox x:Name="EquipmentCombo" 
          Style="{StaticResource ModernComboBox}" 
          Margin="0,0,0,20"
          DisplayMemberPath="InventoryNumber" 
          SelectedValuePath="Id"/>

                <TextBlock Text="Приоритет" Foreground="{DynamicResource MdOnSurfaceVariant}" Margin="4,0,0,8"/>
                <ComboBox x:Name="PriorityCombo" 
          Style="{StaticResource ModernComboBox}" 
          Margin="0,0,0,20">
                    <ComboBoxItem Content="Низкий" Tag="low"/>
                    <ComboBoxItem Content="Средний" Tag="medium" IsSelected="True"/>
                    <ComboBoxItem Content="Высокий" Tag="high"/>
                    <ComboBoxItem Content="Критический" Tag="critical"/>
                </ComboBox>

                <TextBlock Text="Описание проблемы" Foreground="{DynamicResource MdOnSurfaceVariant}" Margin="4,0,0,8"/>
                <TextBox x:Name="DescriptionText" Height="120" Margin="0,0,0,32" 
                         Style="{StaticResource ModernInputO}"
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="12" TextChanged="DescriptionText_TextChanged"/>
                <TextBlock Text="Выполнить до:" Foreground="{DynamicResource MdOnSurfaceVariant}" Margin="4,16,0,8"/>
                <DatePicker x:Name="DeadlinePicker" Height="48" Margin="0,0,0,16"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="Отмена" Grid.Column="0" Margin="0,0,8,0" 
                            Height="40" Cursor="Hand" Click="Cancel_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="{DynamicResource MdPrimary}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="20" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Создать" Grid.Column="1" 
                            Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Page>