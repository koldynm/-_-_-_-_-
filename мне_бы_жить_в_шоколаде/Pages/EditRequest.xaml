<Page x:Class="мне_бы_жить_в_шоколаде.Pages.EditRequest"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Редактирование">

    <Grid Background="{DynamicResource MdSurface}">
        <Border VerticalAlignment="Center" HorizontalAlignment="Center" 
                Width="400" Padding="32" Background="{DynamicResource MdSurfaceContainer}" CornerRadius="28" BorderBrush="Black" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Редактирование" FontSize="24" FontWeight="Medium" 
                           Foreground="{DynamicResource MdOnSurface}" Margin="0,0,0,24"/>

                <TextBlock Text="Оборудование" Foreground="{DynamicResource MdOnSurfaceVariant}" Margin="4,0,0,4" FontSize="12"/>
                <ComboBox x:Name="EquipmentCombo" 
          Style="{StaticResource ModernComboBox}" 
          Margin="0,0,0,20"
          DisplayMemberPath="InventoryNumber" 
          SelectedValuePath="Id"
          SelectedValue="{Binding Request.EquipmentId, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Описание" Foreground="{DynamicResource MdOnSurfaceVariant}" Margin="4,0,0,4" FontSize="12"/>
                <TextBox Text="{Binding Request.Description, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource ModernInputO}" Height="100" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,16" TextChanged="TextBox_TextChanged"/>

                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Статус" Foreground="{DynamicResource MdOnSurfaceVariant}" FontSize="12" Margin="4,0,0,4"/>
                        <ComboBox x:Name="RequestStatusCB" SelectedValue="{Binding Request.Status, UpdateSourceTrigger=PropertyChanged}" 
                  SelectedValuePath="Value" DisplayMemberPath="Name"
                  Style="{StaticResource ModernComboBox}"
                  Height="48"/>
                    </StackPanel>

                    <StackPanel Margin="8,0,0,0">
                        <TextBlock Text="Приоритет" Foreground="{DynamicResource MdOnSurfaceVariant}" FontSize="12" Margin="4,0,0,4"/>
                        <ComboBox x:Name="RequestPriorityCB" SelectedValue="{Binding Request.Priority, UpdateSourceTrigger=PropertyChanged}" 
                  SelectedValuePath="Value" DisplayMemberPath="Name"
                  Style="{StaticResource ModernComboBox}"
                  Height="48"/>
                    </StackPanel>
                </UniformGrid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,32,0,0">
                    <Button Content="Отмена" Click="Cancel_Click" Width="100" Margin="0,0,12,0" Background="Transparent" Foreground="{DynamicResource MdOnSurfaceVariant}"/>
                    <Button Content="Сохранить" Click="Save_Click" Style="{StaticResource PrimaryButton}" Width="140"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>