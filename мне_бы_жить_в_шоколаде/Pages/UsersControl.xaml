<Page x:Class="мне_бы_жить_в_шоколаде.Pages.UsersControl"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Пользователи">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="Пользователи"
                           FontSize="32"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MdOnSurface}"/>
                <TextBlock Text="Административная панель профилей и ролей"
                           FontSize="14"
                           Foreground="{DynamicResource MdOnSurfaceVariant}"
                           Margin="2,4,0,0"/>
            </StackPanel>

            <Button Content="Обновить"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Click="Refresh_Click"
                    Style="{StaticResource PrimaryButton}"
                    Width="140" Height="44"/>
        </Grid>

        <Border Grid.Row="1"
                CornerRadius="12"
                Background="{DynamicResource MdSurfaceContainer}"
                BorderBrush="{DynamicResource MdSurfaceContainerHigh}"
                BorderThickness="1"
                ClipToBounds="True">
            <DataGrid x:Name="UsersGrid"
                      AutoGenerateColumns="False"
                      Style="{StaticResource ModernDataGrid}"
                      ColumnHeaderStyle="{StaticResource MdDataGridColumnHeader}"
                      CanUserAddRows="False"
                      RowHeight="52"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource MdSurfaceContainerHigh}"
                      SelectionChanged="UsersGrid_SelectionChanged"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ИМЯ" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="РОЛЬ" Binding="{Binding RoleDisplayName}" Width="180"/>
                    <DataGridTextColumn Header="ОБНОВЛЕН" Binding="{Binding UpdatedAt, StringFormat=\{0:dd.MM.yy HH:mm\}}" Width="160"/>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="240"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,24,0,0">
            <ComboBox x:Name="RoleCombo"
                      Width="220"
                      Height="40"
                      SelectedValuePath="Tag"
                      Style="{StaticResource ModernComboBox}">
                <ComboBoxItem Content="Пользователь" Tag="requester"/>
                <ComboBoxItem Content="Техник" Tag="technician"/>
                <ComboBoxItem Content="Администратор" Tag="admin"/>
            </ComboBox>
            <Button Content="Сохранить роль"
                    Click="SaveRole_Click"
                    Style="{StaticResource PrimaryButton}"
                    Width="180"
                    Height="40"
                    Margin="12,0,0,0"/>
        </StackPanel>
    </Grid>
</Page>
