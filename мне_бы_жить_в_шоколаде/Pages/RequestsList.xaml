<Page x:Class="мне_бы_жить_в_шоколаде.Pages.RequestsList"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Список заявок">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,32">
            <StackPanel>
                <TextBlock Text="Заявки на ремонт" 
                           FontSize="32" 
                           FontWeight="SemiBold" 
                           Foreground="{DynamicResource MdOnSurface}"/>
                <TextBlock Text="Управление текущими обращениями в сервис" 
                           FontSize="14" 
                           Foreground="{DynamicResource MdOnSurfaceVariant}"
                           Margin="2,4,0,0"/>
            </StackPanel>

            <Button Content="Обновить список" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Top"
                    Click="Button_Click" 
                    Style="{StaticResource PrimaryButton}" 
                    Width="160" Height="44"/>
        </Grid>

        <Border Grid.Row="1" CornerRadius="12" 
                Background="{DynamicResource MdSurfaceContainer}" 
                BorderBrush="{DynamicResource MdSurfaceContainerHigh}"
                BorderThickness="1"
                ClipToBounds="True">
            <DataGrid x:Name="RequestsGrid" 
                      AutoGenerateColumns="False" 
                      Style="{StaticResource ModernDataGrid}"
                      ColumnHeaderStyle="{StaticResource MdDataGridColumnHeader}"
                      CanUserAddRows="False" 
                      RowHeight="52"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource MdSurfaceContainerHigh}"
                      SelectionChanged="RequestsGrid_SelectionChanged" 
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="50">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="16,0,0,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="{StaticResource MdOnSurfaceVariant}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="ОБОРУДОВАНИЕ" Binding="{Binding Equipment.Model}" Width="200"/>

                    <DataGridTextColumn Header="ОПИСАНИЕ ПРОБЛЕМЫ" Binding="{Binding Description}" Width="*"/>

                    <DataGridTextColumn Header="ДАТА" Binding="{Binding CreatedAt, StringFormat=\{0:dd.MM.yy\}}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,24,0,0">
            <StackPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                    <Setter Property="Background" Value="{DynamicResource MdSurfaceContainerHigh}"/>
                    <Setter Property="Foreground" Value="{DynamicResource MdPrimary}"/>
                    <Setter Property="Margin" Value="0,0,12,0"/>
                    <Setter Property="Padding" Value="20,0"/>
                    <Setter Property="Height" Value="40"/>
                </Style>
            </StackPanel.Resources>

            <Button x:Name="TakeRequestButton" Content="Принять в работу" 
                    Click="TakeRequest_Click" 
                    Style="{StaticResource PrimaryButton}" />

            <Button x:Name="EditRequestButton" Content="Изменить" Click="EditRequestButton_Click"/>
            <Button x:Name="RequestInfoButton" Content="Информация" Click="RequestInfoButton_Click"/>

            <Button x:Name="DeleteRequestButton" Content="Удалить" 
                    Click="DeleteRequestButton_Click" 
                    Foreground="{DynamicResource MdTertiary}" 
                    HorizontalAlignment="Right"
                    Width="160" Height="44"/>
            <Button x:Name="ControlRequestButton" Content="Управление заявкой" Click="ControlRequestButton_OnClick"/>
        </StackPanel>
    </Grid>
</Page>