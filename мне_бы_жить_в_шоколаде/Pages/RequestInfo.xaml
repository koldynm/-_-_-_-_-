<Page x:Class="мне_бы_жить_в_шоколаде.Pages.RequestInfo"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:мне_бы_жить_в_шоколаде.Converters"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RequestInfo">

    <Page.Resources>
        <local:RequestStatusConverter x:Key="StatusConverter"/>
        <local:PriorityConverter x:Key="PriorityConverter"/>
    </Page.Resources>

    <Border Background="{DynamicResource MdSurface}"
            BorderBrush="{DynamicResource MdOutline}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="24"
            Margin="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="RequestInfoSP">

                <TextBlock Text="Заявка"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource MdPrimary}"
                           Margin="0,0,0,16"/>

                <UniformGrid Columns="2" Margin="0,0,0,16">
                    <StackPanel Margin="0,0,12,12">
                        <TextBlock Text="Дата создания" Foreground="{DynamicResource MdOnSurfaceVariant}"/>
                        <TextBlock Foreground="{DynamicResource MdOnSurface}"
                                   FontSize="16"
                                   Margin="0,4,0,0"
                                   Text="{Binding CreatedAt, StringFormat=\{0:dd.MM.yy HH:mm\}}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Дедлайн" Foreground="{DynamicResource MdOnSurfaceVariant}"/>
                        <TextBlock Foreground="{DynamicResource MdOnSurface}"
                                   FontSize="16"
                                   Margin="0,4,0,0"
                                   Text="{Binding Deadline, StringFormat=\{0:dd.MM.yy HH:mm\}}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,12">
                        <TextBlock Text="Статус" Foreground="{DynamicResource MdOnSurfaceVariant}"/>
                        <TextBlock Foreground="{DynamicResource MdOnSurface}"
                                   FontSize="16"
                                   Margin="0,4,0,0"
                                   Text="{Binding Status, Converter={StaticResource StatusConverter}}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Приоритет" Foreground="{DynamicResource MdOnSurfaceVariant}"/>
                        <TextBlock Foreground="{DynamicResource MdOnSurface}"
                                   FontSize="16"
                                   Margin="0,4,0,0"
                                   Text="{Binding Priority, Converter={StaticResource PriorityConverter}}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,12">
                        <TextBlock Text="Заявитель" Foreground="{DynamicResource MdOnSurfaceVariant}"/>
                        <TextBlock x:Name="TxtRequester"
                                   Foreground="{DynamicResource MdOnSurface}"
                                   FontSize="16"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Техник" Foreground="{DynamicResource MdOnSurfaceVariant}"/>
                        <TextBlock x:Name="TxtTechnician"
                                   Foreground="{DynamicResource MdOnSurface}"
                                   FontSize="16"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </UniformGrid>

                <Border Background="{DynamicResource MdSurfaceContainer}"
                        BorderBrush="{DynamicResource MdSurfaceContainerHigh}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Оборудование" Foreground="{DynamicResource MdOnSurfaceVariant}"/>
                        <TextBlock x:Name="TxtEquipment"
                                   Foreground="{DynamicResource MdOnSurface}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtEquipmentInfo"
                                   Foreground="{DynamicResource MdOnSurfaceVariant}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Описание проблемы"
                           Foreground="{DynamicResource MdOnSurfaceVariant}"
                           Margin="0,0,0,6"/>
                <Border Background="{DynamicResource MdSurfaceContainer}"
                        BorderBrush="{DynamicResource MdSurfaceContainerHigh}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14"
                        Margin="0,0,0,16">
                    <TextBlock Foreground="{DynamicResource MdOnSurface}"
                               TextWrapping="Wrap"
                               Text="{Binding Description}"/>
                </Border>

                <TextBlock x:Name="TxtCompletedInfo"
                           Foreground="{DynamicResource MdTertiary}"
                           FontSize="16"
                           Margin="0,4,0,0"
                           Visibility="Collapsed"/>

            </StackPanel>
        </ScrollViewer>
    </Border>
</Page>
