<Page x:Class="мне_бы_жить_в_шоколаде.Pages.EquipmentsControl"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:мне_бы_жить_в_шоколаде.Converters"
      Title="Оборудование">
    <Page.Resources>
        <local:EquipmentStatusConverter x:Key="EquipmentStatusConverter"/>
    </Page.Resources>
    
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="Оборудование"
                           FontSize="32"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MdOnSurface}"/>
                <TextBlock Text="Административное создание, редактирование и удаление оборудования"
                           FontSize="14"
                           Foreground="{DynamicResource MdOnSurfaceVariant}"
                           Margin="2,4,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="Добавить"
                        Click="AddEquipment_Click"
                        Style="{StaticResource PrimaryButton}"
                        Width="140" Height="44"
                        Margin="0,0,12,0"/>
                <Button Content="Обновить"
                        Click="Refresh_Click"
                        Style="{StaticResource PrimaryButton}"
                        Width="140" Height="44"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="500"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="1.2*" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    CornerRadius="12"
                    Background="{DynamicResource MdSurfaceContainer}"
                    BorderBrush="{DynamicResource MdSurfaceContainerHigh}"
                    BorderThickness="1"
                    ClipToBounds="True">
                <DataGrid x:Name="EquipmentsGrid"
                          AutoGenerateColumns="False"
                          Style="{StaticResource ModernDataGrid}"
                          ColumnHeaderStyle="{StaticResource MdDataGridColumnHeader}"
                          CanUserAddRows="False"
                          RowHeight="52"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource MdSurfaceContainerHigh}"
                          SelectionChanged="EquipmentsGrid_SelectionChanged"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ИНВ. №" Binding="{Binding InventoryNumber}" Width="130"/>
                        <DataGridTextColumn Header="ТИП" Binding="{Binding TypeName}" Width="150"/>
                        <DataGridTextColumn Header="МОДЕЛЬ" Binding="{Binding Model}" Width="*"/>
                        <DataGridTextColumn Header="СЕРИЙНЫЙ №" Binding="{Binding SerialNumber}" Width="150"/>
                        <DataGridTextColumn Header="ЛОКАЦИЯ" Binding="{Binding LocationName}" Width="150"/>
                        <DataGridTextColumn Header="СТАТУС" Binding="{Binding Status, Converter={StaticResource EquipmentStatusConverter}}" Width="135"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2"
                    CornerRadius="16"
                    Padding="24"
                    Background="{DynamicResource MdSurfaceContainer}"
                    BorderBrush="{DynamicResource MdSurfaceContainerHigh}"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Карточка оборудования"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MdOnSurface}"/>
                        <TextBlock x:Name="EquipmentEditorHintText"
                                   Text="Выберите запись или нажмите «Добавить»"
                                   FontSize="13"
                                   Foreground="{DynamicResource MdOnSurfaceVariant}"
                                   Margin="0,4,0,22"/>

                        <TextBlock Text="Идентификатор" Foreground="{DynamicResource MdOnSurfaceVariant}" Margin="4,0,0,8"/>
                        <TextBox x:Name="EquipmentIdText" Style="{StaticResource ModernInput}" IsReadOnly="True" Margin="0,0,0,16"/>

                        <TextBlock Text="Инвентарный номер" Foreground="{DynamicResource MdOnSurfaceVariant}" Margin="4,0,0,8"/>
                        <TextBox x:Name="InventoryNumberText" Style="{StaticResource ModernInput}" Margin="0,0,0,16"/>

                        <TextBlock Text="Тип" Foreground="{DynamicResource MdOnSurfaceVariant}" Margin="4,0,0,8"/>
                        <ComboBox x:Name="TypeCombo"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  Style="{StaticResource ModernComboBox}"
                                  Height="40"
                                  Margin="0,0,0,16"/>

                        <TextBlock Text="Модель" Foreground="{DynamicResource MdOnSurfaceVariant}" Margin="4,0,0,8"/>
                        <TextBox x:Name="ModelText" Style="{StaticResource ModernInput}" Margin="0,0,0,16"/>

                        <TextBlock Text="Серийный номер" Foreground="{DynamicResource MdOnSurfaceVariant}" Margin="4,0,0,8"/>
                        <TextBox x:Name="SerialNumberText" Style="{StaticResource ModernInput}" Margin="0,0,0,16"/>

                        <TextBlock Text="Локация" Foreground="{DynamicResource MdOnSurfaceVariant}" Margin="4,0,0,8"/>
                        <ComboBox x:Name="LocationCombo"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  Style="{StaticResource ModernComboBox}"
                                  Height="40"
                                  Margin="0,0,0,16"/>

                        <TextBlock Text="Статус" Foreground="{DynamicResource MdOnSurfaceVariant}" Margin="4,0,0,8"/>
                        <ComboBox x:Name="StatusCombo"
                                  Height="40"
                                  SelectedValuePath="Tag"
                                  Style="{StaticResource ModernComboBox}"
                                  Margin="0,0,0,16">
                            <ComboBoxItem Content="Активен" Tag="active"/>
                            <ComboBoxItem Content="Используется" Tag="in_use"/>
                            <ComboBoxItem Content="Сломан" Tag="broken"/>
                            <ComboBoxItem Content="Ремонтируется" Tag="repair"/>
                            <ComboBoxItem Content="На складе" Tag="in_stock"/>
                        </ComboBox>

                        <TextBlock Text="Ссылка на фото" Foreground="{DynamicResource MdOnSurfaceVariant}" Margin="4,0,0,8"/>
                        <TextBox x:Name="PhotoUrlText" Style="{StaticResource ModernInput}" Margin="0,0,0,16"/>

                        <TextBlock Text="Создано" Foreground="{DynamicResource MdOnSurfaceVariant}" Margin="4,0,0,8"/>
                        <TextBox x:Name="CreatedAtText" Style="{StaticResource ModernInput}" IsReadOnly="True" Margin="0,0,0,24"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="Удалить"
                                    Click="Delete_Click"
                                    Style="{StaticResource PrimaryButton}"
                                    Background="{DynamicResource MdTertiary}"
                                    Height="40"/>
                            <Button Grid.Column="2"
                                    Content="Сохранить"
                                    Click="SaveEquipment_Click"
                                    Style="{StaticResource PrimaryButton}"
                                    Height="40"/>
                        </Grid>

                        <Button Content="Очистить форму"
                                Click="ClearEquipmentForm_Click"
                                Height="40"
                                Margin="0,12,0,0"
                                Background="Transparent"
                                Foreground="{DynamicResource MdOnSurfaceVariant}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
