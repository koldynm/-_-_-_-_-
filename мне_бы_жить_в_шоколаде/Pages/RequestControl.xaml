<Page x:Class="мне_бы_жить_в_шоколаде.Pages.RequestControl"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:мне_бы_жить_в_шоколаде.Converters"
      mc:Ignorable="d"
      Title="Управление заявкой" Height="450" Width="800">
    
    <Page.Resources>
        <local:RequestStatusConverter x:Key="StatusConverter"/>
        <local:PriorityConverter x:Key="PriorityConverter"/>
    </Page.Resources>
    
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*"/>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource MdSurface}"
                BorderBrush="{DynamicResource MdOutline}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="RequestInfo">
                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="{DynamicResource MdPrimary}" Text="Заявка"/>
                        
                        <UniformGrid Columns="2" Margin="0,0,0,16">
                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="Дата создания" Foreground="{DynamicResource MdOnSurfaceVariant}"/>
                                <TextBlock Foreground="{DynamicResource MdOnSurface}" FontSize="16" Margin="0,4,0,0" Text="{Binding CreatedAt, StringFormat=\{0:dd.MM.yy HH:mm\}}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Дедлайн" Foreground="{DynamicResource MdOnSurfaceVariant}"/>
                                <TextBlock Foreground="{DynamicResource MdOnSurface}" FontSize="16" Margin="0,4,0,0" Text="{Binding Deadline, StringFormat=\{0:dd.MM.yy HH:mm\}}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="Статус" Foreground="{DynamicResource MdOnSurfaceVariant}"/>
                                <TextBlock 
                                    Foreground="{DynamicResource MdOnSurface}" 
                                    FontSize="16" 
                                    Margin="0,4,0,0" 
                                    Text="{Binding Status, Converter={StaticResource StatusConverter}}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Приоритет" Foreground="{DynamicResource MdOnSurfaceVariant}"/>
                                <TextBlock 
                                    Foreground="{DynamicResource MdOnSurface}" 
                                    FontSize="16" 
                                    Margin="0,4,0,0"
                                    Text="{Binding Priority, Converter={StaticResource PriorityConverter}}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="Заявитель" Foreground="{DynamicResource MdOnSurfaceVariant}"/>
                                <TextBlock x:Name="TxtRequester" Foreground="{DynamicResource MdOnSurface}" FontSize="16" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Техник" Foreground="{DynamicResource MdOnSurfaceVariant}"/>
                                <TextBlock x:Name="TxtTechnician" Foreground="{DynamicResource MdOnSurface}" FontSize="16" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </UniformGrid>

                        <Border Background="{DynamicResource MdSurfaceContainer}"
                                BorderBrush="{DynamicResource MdSurfaceContainerHigh}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Оборудование" Foreground="{DynamicResource MdOnSurfaceVariant}"/>
                                <TextBlock x:Name="TxtEquipment" Foreground="{DynamicResource MdOnSurface}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtEquipmentInfo" Foreground="{DynamicResource MdOnSurfaceVariant}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Описание проблемы" Foreground="{DynamicResource MdOnSurfaceVariant}" Margin="0,0,0,6"/>
                        <Border Background="{DynamicResource MdSurfaceContainer}"
                                BorderBrush="{DynamicResource MdSurfaceContainerHigh}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14"
                                Margin="0,0,0,16">
                            <TextBlock 
                                Foreground="{DynamicResource MdOnSurface}" 
                                TextWrapping="Wrap"
                                Text="{Binding Description}"/>
                        </Border>

                        <TextBlock x:Name="TxtCompletedInfo" Foreground="{DynamicResource MdTertiary}" FontSize="16" Margin="0,16,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="BtnRefuse" Content="Отказаться" Style="{StaticResource PrimaryButton}" Click="BtnRefuse_OnClick" Margin="0,0,6,0"/>
                    <Button Grid.Column="1" x:Name="BtnComplete" Content="Завершить" Style="{StaticResource PrimaryButton}" Click="BtnComplete_Click" Margin="6,0,0,0"/>
                </Grid>
            </Grid>
        </Border>

        <Border 
            Grid.Column="2"
            Background="{DynamicResource MdSurface}"
            BorderBrush="{DynamicResource MdOutline}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Чат по заявке" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource MdOnSurface}" Margin="0,0,0,16"/>

                <ScrollViewer Grid.Row="1" x:Name="ChatScroller" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="MessagesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="MsgBorder" Background="{DynamicResource MdSurfaceContainerHigh}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <StackPanel x:Name="MessageContainer">
                                        <TextBlock Text="{Binding CreatedAt, StringFormat=dd.MM HH:mm}" FontSize="10" Foreground="{DynamicResource MdOutline}"/>
                                        <TextBlock x:Name="MessageText" Text="{Binding MessageText}" Foreground="{DynamicResource MdOnSurface}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsOwnMessage}" Value="True">
                                        <Setter TargetName="MsgBorder" Property="HorizontalAlignment" Value="Right"/>
                                        <Setter TargetName="MsgBorder" Property="Background" Value="#D1E4FF"/>
                                        <Setter TargetName="MessageContainer" Property="Margin" Value="40,0,0,8"/>
                                        <Setter TargetName="MessageText" Property="Foreground" Value="Black"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtNewMessage" Style="{DynamicResource ModernInput}" TextWrapping="Wrap" MaxHeight="100"/>
                    <Button Grid.Column="1" Content="Отправить" Style="{StaticResource PrimaryButton}" Width="100" Margin="8,0,0,0" Click="BtnSendMessage_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
